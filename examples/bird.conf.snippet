# Minimal example to consume rtbhd generated routes.
# NOTE: Example uses private ASN 65500.

# 1) Include generated blackhole routes:
include "/var/lib/rtbhd/rtbh_auto.conf";

# 2) Example BGP session. Adjust policy/ASN/IP to your network.
protocol bgp uplink_rtbh {
  local as 65500;
  neighbor 192.0.2.1 as 65000;

  ipv4 {
    import none;
    export where proto = "rtbh_auto_v4";
  };

  ipv6 {
    import none;
    export where proto = "rtbh_auto_v6";
  };
}
