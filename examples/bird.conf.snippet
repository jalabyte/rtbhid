# Minimal example to consume rtbhd generated routes + peers.
# NOTE: Example uses private ASN 65500 (set via RTBH_LOCAL_ASN).

# 1) Include generated blackhole routes:
include "/var/lib/rtbhd/rtbh_auto.conf";

# 2) Include generated BGP peers:
include "/var/lib/rtbhd/rtbh_peers_auto.conf";

# Peer definitions are generated automatically by rtbhd dashboard/API.
