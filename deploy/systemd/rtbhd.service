[Unit]
Description=RTBH Agent
After=network.target bird.service

[Service]
Type=simple
User=rtbhd
Group=bird
EnvironmentFile=/etc/default/rtbhd
# Required when RTBH_BGP_ENGINE=custom to bind TCP port 179.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/rtbhd
Restart=on-failure
RestartSec=5
WorkingDirectory=/var/lib/rtbhd

[Install]
WantedBy=multi-user.target
