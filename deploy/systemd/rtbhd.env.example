# Persistent state and generated Bird include output
RTBH_STATE_PATH=/var/lib/rtbhd/state.json
RTBH_BIRD_OUTPUT=/var/lib/rtbhd/rtbh_auto.conf
RTBH_BIRD_PEERS_OUTPUT=/var/lib/rtbhd/rtbh_peers_auto.conf

# Enable Bird reload after route list changes
RTBH_BIRD_RELOAD=true
RTBH_BIRD_COMMAND=birdc -s /var/run/bird/bird.ctl configure
RTBH_LOCAL_ASN=65500
# Optional export tags for all RTBH announcements (comma/space separated):
# examples:
#   RTBH_EXPORT_STD_COMMUNITIES=65535:666
#   RTBH_EXPORT_LARGE_COMMUNITIES=65500:666:1,65500:666:2
RTBH_EXPORT_STD_COMMUNITIES=65535:666
RTBH_EXPORT_LARGE_COMMUNITIES=65535:666:666

# Agent configuration
RTBH_AGENT_ID=agent-01
RTBH_AGENT_NAME=router-01
RTBH_PORTAL_URL=portal.example.com:50051
RTBH_MODE=agent
RTBH_BIRD_CONF_DIR=/etc/bird
RTBH_BIRD_RELOAD_CMD=birdc configure

# BGP engine: bird (default) or custom (embedded BGP server).
# Set to custom to stop using BIRD. Stop/disable bird.service first: the
# embedded server binds TCP/179.
RTBH_BGP_ENGINE=bird
# RTBH_BGP_LISTEN_ADDR=:179
# RTBH_BGP_ROUTER_ID=192.0.2.1
# RTBH_BGP_NEXTHOP_V4=192.0.2.1
# RTBH_BGP_NEXTHOP_V6=2001:db8::1
# RTBH_BGP_HOLD_TIME_SEC=90
# RTBH_BGP_ENABLE_IPV6=true

# Auto-accept is controlled from the portal ASN whitelist. The agent receives
# the enabled ASN list over gRPC.
