# Bind API/dashboard to localhost. Put reverse proxy + auth in front.
RTBH_LISTEN_ADDR=127.0.0.1:8080

# Persistent state and generated Bird include output
RTBH_STATE_PATH=/var/lib/rtbhd/state.json
RTBH_BIRD_OUTPUT=/var/lib/rtbhd/rtbh_auto.conf
RTBH_BIRD_PEERS_OUTPUT=/var/lib/rtbhd/rtbh_peers_auto.conf

# Enable Bird reload after route list changes
RTBH_BIRD_RELOAD=true
RTBH_BIRD_COMMAND=birdc -s /run/bird/bird.ctl configure
RTBH_LOCAL_ASN=65500
# Optional export tags for all RTBH announcements (comma/space separated):
# examples:
#   RTBH_EXPORT_STD_COMMUNITIES=65535:666
#   RTBH_EXPORT_LARGE_COMMUNITIES=65500:666:1,65500:666:2
RTBH_EXPORT_STD_COMMUNITIES=65535:666
RTBH_EXPORT_LARGE_COMMUNITIES=

# Sync behavior
RTBH_SYNC_USER_AGENT=rtbhd/1.0
RTBH_SCHEDULER_TICK_SECONDS=15

# Built-in dashboard/API login.
# Leave empty to disable built-in auth (not recommended for public exposure).
RTBH_AUTH_USER=admin
RTBH_AUTH_PASS=change-me
# Optional static secret; if empty a random secret is generated on startup.
RTBH_AUTH_SESSION_SECRET=
RTBH_AUTH_SESSION_TTL_HOURS=24
# Set true only when served behind HTTPS directly on this service.
RTBH_AUTH_COOKIE_SECURE=false
